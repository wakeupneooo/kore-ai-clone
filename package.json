{
  "name": "kore-ai-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend clone of Kore.ai with xAI-style sections, Grok Bot integration, and VAIO branding",
  "scripts": {
    "dev": "npx serve . -l 8091 --no-clipboard",
    "build": "node scripts/build.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "npx eslint main.js",
    "lint:css": "npx stylelint 'styles.css'",
    "format": "npx prettier --write '**/*.{html,css,js,json,md}'",
    "format:check": "npx prettier --check '**/*.{html,css,js,json,md}'"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "serve": "^14.2.0",
    "stylelint": "^16.6.0",
    "stylelint-config-standard": "^36.0.0",
    "terser": "^5.31.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
